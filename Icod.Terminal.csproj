<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<Copyright>Copyright (c) 2026 Timothy J. Bruce</Copyright>
		<LangVersion>13.0</LangVersion>
		<OutputType>Library</OutputType>
		<TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<GenerateDocumentationFile>true</GenerateDocumentationFile>
		<EnableDefaultCompileItems>false</EnableDefaultCompileItems>
		<AssemblyName>Icod.Terminal</AssemblyName>
		<RootNamespace>Icod.Terminal</RootNamespace>
		<Configurations>Debug;Staging;Release</Configurations>
		<AllowUnsafeBlocks>true</AllowUnsafeBlocks>
	</PropertyGroup>
	<PropertyGroup>
		<PackageId>Icod.Terminal</PackageId>
		<Title>Icod.Terminal</Title>
		<Authors>Timothy J. Bruce</Authors>
		<Description>Managed, cross-platform live-terminal session, endpoint, mode, input, lifecycle, and terminal-control foundation for .NET.</Description>
		<PackageReleaseNotes>Icod.Terminal 1.25.0-alpha.5 gives bounded size-aware deadlines to persistent Kitty raster uploads, animation-frame appends and partial-frame edits while retaining one-second control-command deadlines. Includes alpha.4 Kitty DA1 compatibility and the earlier 1.25 prerelease corrections. Release notes: https://github.com/uniblab/Icod.Terminal/blob/main/docs/releases/1.25.0-alpha.5.md.</PackageReleaseNotes>
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<PackageIcon>icon.png</PackageIcon>
		<PackageProjectUrl>https://github.com/uniblab/Icod.Terminal</PackageProjectUrl>
		<PackageLicenseExpression>LGPL-3.0-or-later</PackageLicenseExpression>
		<PackageRequireLicenseAcceptance>true</PackageRequireLicenseAcceptance>
		<IncludeSymbols>true</IncludeSymbols>
		<SymbolPackageFormat>snupkg</SymbolPackageFormat>
		<PublishRepositoryUrl>true</PublishRepositoryUrl>
		<EmbedUntrackedSources>true</EmbedUntrackedSources>
		<Deterministic>true</Deterministic>
		<PackageTags>animation;animation-frame;ansi;apc;capability-inspection;capability-planning;capability-routing;clipboard;cmdline-url;color-ownership;color-query;command-region;conemu;console;contour;control-language;cross-platform;csharp;csi;csi-grammar;csi-parameters;current-directory;cursor;dcs;dec-private-mode;decrqss;decscusr;desktop-notification;dotnet;dynamic-color;frame-lifecycle;icod;indexed8;interactive;interactive-notification;iterm2;iterm2-shell-integration;kitty;kitty-graphics;kitty-notification;lifecycle;lifecycle-observation;mode-2026;mouse-pointer;notification;notification-event;notification-icon;notification-query;notification-update;osc10;osc104;osc11;osc12;osc13;osc133;osc1337;osc14;osc17;osc19;osc22;osc4;osc52;osc633;osc777;osc777-notification;osc9;osc9-4;osc9-9;osc9-notification;osc99;output-transaction;ownership-state;palette;persistent-graphics;persistent-raster;pixel-geometry;pointer-shape;progress;prompt;prompt-click;raster;raster-animation;raster-graphics;raster-placeholder;raster-placement;raster-resource;relative-placement;remote-host;restoration;rgb24;rgba32;scoped-color;screen-output;screen-planning;semantic-event;semantic-history;semantic-prompt;semantic-routing;shell-integration;shell-integration-version;sixel;synchronized-output;terminal;terminal-animation;terminal-color;terminal-control;terminal-dimensions;terminal-input;terminal-profile;terminal-progress;terminfo;termios;titled-notification;tty;tui;tui-rendering;unicode-placeholder;urxvt;user-variable;virtual-placement;vscode;vscode-shell-integration;vt100;wezterm;windows-current-directory;windows-terminal;xterm
</PackageTags>
		<RepositoryUrl>https://github.com/uniblab/Icod.Terminal</RepositoryUrl>
		<RepositoryType>git</RepositoryType>
		<GenerateAppxPackageOnBuild>false</GenerateAppxPackageOnBuild>
		<EnablePackageValidation>true</EnablePackageValidation>
	</PropertyGroup>

	<PropertyGroup Condition=" '$(PlatformTarget)' == '' ">
		<PlatformTarget>AnyCPU</PlatformTarget>
	</PropertyGroup>
	<PropertyGroup Condition=" '$(Configuration)' == 'Debug' ">
		<ErrorReport>prompt</ErrorReport>
		<WarningLevel>2</WarningLevel>
		<DebugSymbols>true</DebugSymbols>
		<DebugType>portable</DebugType>
		<Optimize>false</Optimize>
		<DefineConstants>DEBUG;TRACE</DefineConstants>
		<SignAssembly>false</SignAssembly>
		<TreatWarningsAsErrors>false</TreatWarningsAsErrors>
	</PropertyGroup>
	<PropertyGroup Condition=" '$(Configuration)' == 'Staging' ">
		<ErrorReport>prompt</ErrorReport>
		<WarningLevel>3</WarningLevel>
		<DebugSymbols>true</DebugSymbols>
		<DebugType>portable</DebugType>
		<Optimize>false</Optimize>
		<DefineConstants>TRACE</DefineConstants>
		<SignAssembly>false</SignAssembly>
		<TreatWarningsAsErrors>false</TreatWarningsAsErrors>
	</PropertyGroup>
	<PropertyGroup Condition=" '$(Configuration)' == 'Release' ">
		<ErrorReport>prompt</ErrorReport>
		<WarningLevel>4</WarningLevel>
		<DebugType>portable</DebugType>
		<Optimize>true</Optimize>
		<SignAssembly>false</SignAssembly>
		<TreatWarningsAsErrors>true</TreatWarningsAsErrors>
		<WarningsNotAsErrors>CS1591</WarningsNotAsErrors>
	</PropertyGroup>

	<ItemGroup>
		<Compile Include="src\**\*.cs" />
		<None Include="icon.png" Pack="true" PackagePath="" />
		<EmbeddedResource Remove="samples\**" />
		<None Remove="samples\**" />
		<EmbeddedResource Remove="tests\**" />
		<None Remove="tests\**" />
	</ItemGroup>

	<ItemGroup>
		<None Include="README.md" Pack="true" PackagePath="\" />
		<Content Include="LICENSE">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
			<TargetPath>$(AssemblyName).LICENSE.txt</TargetPath>
			<Pack>true</Pack>
			<PackagePath>\</PackagePath>
		</Content>
		<None Include="icod_tui_toolchain.jpg" Pack="true" PackagePath="\" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Icod.TermInfo" Version="1.17.0" />
		<PackageReference Include="Icod.Timing" Version="1.0.0" />
	</ItemGroup>
</Project>
